# Test and build output, all regenerated
design/*.png
design/*.log
design/*.txt
design/chromium-profile/
design/mock-dev.html
design/mock-page.html
# Built mock carries the real room snapshot; it is published, never committed
design/environment-control-mock.html
design/snapshot-ui.html
design/snapshot-seed.js
# Room snapshot read from Home Assistant, regenerated by ha-snap/*.py
design/ha-snap/*.json

# Secrets never belong here; these catch one dropped in by mistake
.env
.env.*
*.pem
*.key
secrets.yaml
.secrets*

# Dependencies, caches and build output
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.coverage
dist/
build/
*.zip
test-results/
playwright-report/
